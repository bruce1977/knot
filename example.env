# Knowledge Pipeline Environment Variables
# Copy this file to .env and fill in your values

# ─── Analysis Configuration ───────────────────────────────────────────────────

# LLM API address (OpenAI-compatible endpoint)
KB_LLM_BASE_URL=http://localhost:11434

# LLM API key (leave empty for Ollama)
KB_LLM_API_KEY=

# Default model (used for both metadata and rating extraction)
KB_LLM_MODEL=qwen2.5:3b

# Optional: Metadata extraction model (inherits KB_LLM_MODEL if not set)
# KB_LLM_META_MODEL=

# Optional: Rating extraction model (inherits KB_LLM_MODEL if not set)
# KB_LLM_RATE_MODEL=

# LLM request timeout in milliseconds
KB_LLM_TIMEOUT_MS=120000

# Backend type: auto | ollama | openai
KB_LLM_PROVIDER=auto

# ─── System One (Jev) Rating ─────────────────────────────────────────────────
# Used by the extractor_rate_systemone plugin only

# TypeSafe AI API base URL
# KB_SYSTEMONE_BASE_URL=https://api.typesafe.ai

# TypeSafe AI API key (required for extractor_rate_systemone)
# KB_SYSTEMONE_API_KEY=

# Optional: System One judge model (defaults to "jev-latest" from plugin config)
# KB_SYSTEMONE_MODEL=

# System One request timeout in milliseconds
# KB_SYSTEMONE_TIMEOUT_MS=60000

# ─── Profile Configuration ───────────────────────────────────────────────────

# Default knowledge base profile directory (used when not passing arguments)
# Example: D:/knowledge/articles/ai
KB_DEFAULT_PROFILE=

# ─── Sync Configuration ──────────────────────────────────────────────────────

# Knowledge base root directory (optional, fallback for profile discovery)
KB_BASE_PATH=

# WeKnora API base URL (required for sync)
WEKNORA_BASE_URL=

# WeKnora API key (required for sync)
WEKNORA_API_KEY=

# WeKnora Forge base URL (required for sync:forge)
WEKNORA_FORGE_BASE_URL=

# Forge HMAC signing secret, default for sync:forge
# (profile config weknora.api_secret takes priority when set)
WEKNORA_API_SECRET=
